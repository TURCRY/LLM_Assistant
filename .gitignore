########################################
# Python
########################################
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

########################################
# Environnements / secrets
########################################
.env
config/.env
*.key
*.pem
*.secret

########################################
# Environnements virtuels
########################################
.venv/
venv/
env/


########################################
# IDE / OS
########################################
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

########################################
# Logs / temporaires
########################################
*.log
*.tmp
*.bak
*.old

########################################
# Dossiers locaux non versionnés
########################################
temp/
data/

!data/*.example.json
!data/README_data.md

########################################
# Médias et fichiers lourds locaux
########################################
*.wav
*.mp3
*.flac
*.mp4
*.m4a
*.zip

########################################
# Sorties générées / artefacts locaux
########################################
*.jsonl
*_progress.json
adaptation_pcfixe/spooler job/server_response/*spooler_test/
adaptation_pcfixe/spooler job/server_response/*deepseek_spooler_test/
requirements_complet.txt
app_from_codex_checkpoint*.py
app.py.INCIDENT_RESTORE*.py
audit_app_after_restore*.patch
diff_app_actuel.patch
patch_lot1_parties*.diff

########################################
# Caches Python dans sous-dossiers
########################################
scripts/__pycache__/
tools/**/__pycache__/
utils/__pycache__/

# caches Python supplémentaires
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/


########################################
# Fichiers métier à conserver
########################################
!config/*.json
!config/*.yaml
!config/*.yml
!docs/**
!*.md
!requirements.txt
!*.bat

# fichiers temporaires Word
~$*.docx
~WRL*.tmp